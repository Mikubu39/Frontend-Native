# Sao chép file này thành `.env` rồi điền khoá thật.
# `.env` đã nằm trong .gitignore — KHÔNG BAO GIỜ commit khoá.
#
# Lấy khoá: https://aistudio.google.com/apikey  ->  "Create API key"
# (miễn phí, không cần thẻ tín dụng)
#
# Biến môi trường thật luôn thắng file này, nên vẫn chạy được:
#   GEMINI_API_KEY=... uvicorn nihongo_ai.api:app --port 8000
GEMINI_API_KEY=

# Không bắt buộc. Mặc định gemini-3.5-flash — xem phần chọn model trong
# src/nihongo_ai/llm.py để biết vì sao không dùng bản mới nhất.
# GEMINI_MODEL=gemini-3.5-flash
