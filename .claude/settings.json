{
  "enabledPlugins": {
    "expo@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/tsc-gate.mjs",
            "shell": "bash",
            "timeout": 300,
            "statusMessage": "Type-checking before finishing..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/graph-gate.mjs",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__codebase-memory-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/graph-gate.mjs",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
