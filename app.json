{
  "expo": {
    "name": "Nihongo",
    "slug": "Frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nihongo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tungdzai123.Frontend",
      "usesCleartextTraffic": true,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Nihongo dùng Camera để quét mã QR kết bạn."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Cho phép Nihongo dùng micro để nghe bạn nói tiếng Nhật khi luyện hội thoại.",
          "speechRecognitionPermission": "Cho phép Nihongo nhận diện giọng nói để chuyển câu tiếng Nhật bạn nói thành chữ.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "1776382180172619",
          "clientToken": "3e3c730328a7d2b83cc855f65396915b",
          "displayName": "Frontend",
          "scheme": "fb1776382180172619"
        }
      ],
      "expo-audio",
      "./plugins/withAndroidMaxRefreshRate.js"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f83a1304-58f3-4e6a-b91c-28ccb024b5b9"
      }
    }
  }
}